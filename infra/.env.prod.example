# Copy to infra/.env.prod and replace every value marked replace-with.
POSTGRES_DB=signalos
POSTGRES_USER=signalos
POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-secret
JWT_SECRET=replace-with-a-random-64-character-hex-secret
INTEGRATION_CREDENTIAL_KEY=replace-with-a-random-64-character-hex-secret

CORS_ALLOWED_ORIGINS=https://open-comunity.eridu.top
VITE_API_BASE_URL=/api
SUPPORT_CONTACT_EMAIL=support@open-comunity.eridu.top

# Email is disabled until MAIL_ENABLED=true and a working SMTP service is configured.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true

# Keep true unless SMTP is configured: setting false lets anyone register with an unverified
# email address (spam/bot accounts) and is only a temporary bridge until email works.
REQUIRE_EMAIL_VERIFICATION=true

# Nightly backup time in UTC (0-23).
BACKUP_HOUR_UTC=2
