# Copy this file to infra/.env and fill in real values. Never commit the filled copy.
# infra/.env is gitignored; this example is tracked and must contain no real secrets.

# Database
POSTGRES_DB=signalos
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-a-long-random-password

# API security. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-64-character-hex-string

# Browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3002

# Mail (optional, only needed to send real email)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password