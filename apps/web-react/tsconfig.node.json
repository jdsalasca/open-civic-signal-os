{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig-node.tsbuildinfo"
  },
  // ports.ts is imported by vite.config.ts and playwright.config.ts, so a project that only listed
  // the config would refuse to resolve it.
  "include": ["vite.config.ts", "playwright.config.ts", "playwright.global-setup.ts", "ports.ts"]
}
